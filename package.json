{
    "name": "propulsion",
    "private": true,
    "workspaces": [
        "skills/write-skill"
    ],
    "scripts": {
        "checks": "bun run lint && bun run format && bun run test && bun run validate:skills",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --no-error-on-unmatched-pattern",
        "test": "bun test scripts",
        "validate:skills": "bun scripts/validate-skills.js"
    },
    "devDependencies": {
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.24.0"
    },
    "packageManager": "bun@1.3.11"
}
