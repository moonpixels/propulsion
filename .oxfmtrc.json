{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": [
        "node_modules/**",
        ".opencode/node_modules/**",
        ".agents/**"
    ],
    "printWidth": 80,
    "tabWidth": 4,
    "singleQuote": true,
    "sortImports": {
        "groups": [
            ["builtin", "external"],
            ["internal", "subpath"],
            ["parent", "sibling", "index"],
            "unknown"
        ]
    },
    "sortPackageJson": {
        "sortScripts": true
    }
}
