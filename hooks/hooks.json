{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|clear|compact|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/run-hook.cmd\" session-start",
                        "timeout": 10,
                        "statusMessage": "Loading Propulsion workflow"
                    }
                ]
            }
        ]
    }
}
